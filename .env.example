# Copy to .env (never commit .env). Docker Compose reads it automatically.

# Required by the SEC fair-access policy: your name and a contact email.
SEC_USER_AGENT="Your Name your.email@example.com"

# Enables the admin endpoints. Use a long random value, for example: openssl rand -hex 24
PEERLENS_ADMIN_TOKEN=

# Password for the local PostgreSQL container.
POSTGRES_PASSWORD=peerlens-local
